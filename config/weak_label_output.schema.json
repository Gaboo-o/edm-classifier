    "label_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "confidence",
        "support",
        "evidence_refs",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label_id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Heuristic support score, not a calibrated probability."
        },
        "support": {
          "type": "string",
          "enum": [
            "strong",
            "moderate",
            "weak"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "labeled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "labels": {
            "minItems": 1
          },
          "uncertainty": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "uncertain"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "labels": {
            "maxItems": 0
          },
          "uncertainty": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "out_of_scope"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "labels": {
            "maxItems": 0
          },
          "candidates": {
            "maxItems": 0
          },
          "uncertainty": {
            "type": "object"
          }
        }
      }
    }
  ]
}
