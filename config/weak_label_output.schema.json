{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ytm-converter.local/schemas/weak-label-output.schema.json",
  "title": "EDM Weak Label Output",
  "description": "Conservative weak labels mapped strictly to taxonomy.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "track_id",
    "status",
    "labels",
    "candidates",
    "uncertainty",
    "ignored_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "taxonomy_version": {
      "const": "0.1.0"
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "labeled",
        "uncertain",
        "out_of_scope"
      ]
    },
    "labels": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label_result"
      },
      "description": "Accepted training labels only. Do not include derived parent labels."
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label_result"
      },
      "description": "Plausible but non-accepted labels for review."
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "notes"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "insufficient_evidence",
                "conflicting_evidence",
                "boundary_ambiguous",
                "out_of_taxonomy",
                "not_edm",
                "other"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      ]
    },
    "ignored_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "reason"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  },
