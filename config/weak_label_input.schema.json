{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ytm-converter.local/schemas/weak-label-input.schema.json",
  "title": "EDM Weak Label Input",
  "description": "One track plus independently collected evidence to be mapped into the EDM taxonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "track",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "taxonomy_version": {
      "const": "0.1.0"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "artist",
        "title"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "album": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "bpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "youtube_video_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "type",
          "claim"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "genre",
              "style",
              "tags",
              "release_metadata",
              "editorial",
              "audio_descriptor",
              "other"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "independence_group": {
            "type": [
              "string",
              "null"
            ],
            "description": "Evidence items with the same non-null group may share an upstream source and must not be counted as independent corroboration."
          },
          "reliability": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ],
            "default": "unknown"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
