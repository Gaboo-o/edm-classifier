{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDM V2 weak label output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "status",
    "labels",
    "reason"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "labeled",
        "uncertain",
        "reject"
      ]
    },
    "labels": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "reason": {
      "type": "string"
    }
  }
}
